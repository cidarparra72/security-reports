# Backend API (Vercel → Render/Railway, etc.)
# NEXT_PUBLIC_API_BASE=https://tu-api.onrender.com

# Proxy en dev local (next.config.mjs)
# NEXT_PROXY_API=http://127.0.0.1:8000

# --- Modos visibles en la UI ---
# Sin definir = todos (local: código + API + Probe + ZAP)
# Live sin Docker/ZAP:
NEXT_PUBLIC_SCANNER_FEATURES=code,historial

# Con API en vivo y ZAP (requiere Docker en el servidor del backend):
# NEXT_PUBLIC_SCANNER_FEATURES=code,historial,dast
